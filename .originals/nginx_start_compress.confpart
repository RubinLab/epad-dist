#Nginx default.conf                                                                                                                                                                                                                                                           
#/etc/nginx/conf.d                     

server {
        listen       {epadjs_port};  
        server_name  localhost;
        # means no limit
        client_max_body_size 0;
        proxy_read_timeout 180s;
        gzip on;
        # Frames reach nginx proxied from epadlite. Without gzip_proxied nginx never
        # compresses a proxied response. The frame Content-Type ("multipart/related;
        # type=...; boundary=...") includes parameters, and nginx compares the whole
        # string, so no gzip_types entry matches it. Only "*" does.
        gzip_proxied any;
        gzip_types      *;
        gzip_min_length {compression_minsize};
        proxy_buffer_size          128k;
        proxy_buffers              4 256k;
        proxy_busy_buffers_size    256k;

        
        include /etc/nginx/mime.types;
        
        location / {
                root   /usr/share/nginx/html;
                index  index.html index.htm;
                try_files $uri $uri/ /index.html;
        }
