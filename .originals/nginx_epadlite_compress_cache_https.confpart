
        location /{epadlite_loc} {
                add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
                add_header 'Access-Control-Allow-Origin' '*';
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
                proxy_set_header Host $host;
                proxy_pass_request_headers on;
                proxy_pass http://epad_lite:8080;
        }

        # Compress each frame once and cache the compressed bytes. With gzip and
        # proxy_cache in one location, nginx caches the plain frame and gzips it again
        # on every hit (~0.2 s of CPU per 27 MB DBT frame). Two hops instead:
        # outer location caches, inner location (loopback only) compresses.
        location /{epadlite_loc}/wado {
                proxy_cache my_cache;
                proxy_ignore_headers Cache-Control;
                proxy_cache_valid 200 302 60m;
                proxy_cache_key $uri$is_args$args;
                proxy_cache_purge PURGE from all;
                add_header X-Cache-Status $upstream_cache_status;
                add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
                add_header 'Access-Control-Allow-Origin' '*';
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
                gzip off;
                gunzip on;   # clients that do not accept gzip still get plain bytes
                proxy_set_header Host $host;
                proxy_set_header Accept-Encoding gzip;   # one compressed entry serves every client
                proxy_http_version 1.1;   # gzip skips HTTP/1.0, the proxy default
                proxy_pass_request_headers on;
                proxy_pass https://127.0.0.1:{epadjs_port}/_gz/{epadlite_loc}/wado;
        }

        location /_gz/{epadlite_loc}/wado {
                allow 127.0.0.1;
                deny all;
                proxy_set_header Host $host;
                proxy_pass_request_headers on;
                proxy_pass http://epad_lite:8080/{epadlite_loc}/wado;
        }
